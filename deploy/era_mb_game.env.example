# Конфигурация окружения production для era_mobile_api.
# Лежит на сервере: /opt/era/era_mb_game/shared/era_mb_game.env
# Читается systemd-юнитом (EnvironmentFile). Секреты в git не попадают.

RAILS_ENV=production
RAILS_LOG_TO_STDOUT=1

# Единая база сервера (отдельная база мобильной игры, НЕ eraofchange_production)
ERA_MB_DATABASE=era_mb_game_production
ERA_MB_DB_USER=deploy
ERA_MB_DB_PASSWORD=gfhjkm

# Секреты (сгенерированы openssl, см. /opt/era/era_mb_game/shared/)
SECRET_KEY_BASE=CHANGE_ME_secret_key_base
MB_MASTER_KEY=CHANGE_ME_master_key

TRADE_SESSION_TIMEOUT=120

REDIS_URL=redis://localhost:6379/2

# puma.rb читает PORT; PUMA_PORT игнорируется
PORT=3001
