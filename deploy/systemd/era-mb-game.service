[Unit]
Description=Era Mobile API (Puma, port 3001)
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=deploy
Group=deploy

WorkingDirectory=/opt/era/era_mb_game/current
Environment=RAILS_ENV=production
Environment=PATH=/home/deploy/.rbenv/shims:/home/deploy/.rbenv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/opt/era/era_mb_game/shared/era_mb_game.env

ExecStart=/home/deploy/.rbenv/bin/rbenv exec bundle exec puma -C /opt/era/era_mb_game/current/config/puma.rb
Restart=always
RestartSec=3

StandardOutput=append:/opt/era/era_mb_game/shared/log/puma.log
StandardError=append:/opt/era/era_mb_game/shared/log/puma.err.log

[Install]
WantedBy=multi-user.target
